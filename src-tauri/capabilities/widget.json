{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widget",
  "description": "Local signed-in dock window only; no remote webview IPC access.",
  "windows": ["main"],
  "permissions": ["updater:allow-check", "updater:allow-download-and-install", "core:default", "core:window:allow-current-monitor", "core:window:allow-set-size", "core:window:allow-set-min-size", "core:window:allow-start-dragging", "core:window:allow-minimize", "core:window:allow-close", "core:window:allow-is-maximized", "core:window:allow-toggle-maximize", "core:window:allow-unmaximize", "core:window:allow-set-always-on-top", "core:window:allow-set-effects"]
}
