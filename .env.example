# Supabase Configuration (Template)
# Copy this file to .env and fill in your actual credentials
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_MODE=mock

# Public Turnstile site key; secrets belong in Supabase Edge Function secrets.
VITE_TURNSTILE_SITE_KEY=

# Server only: never prefix the Gemini key with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional public browser-store listing. Leave blank for the early-access guide.
# Set after publishing the companion, then redeploy Netlify.
VITE_MUSIC_EXTENSION_STORE_URL=

# Optional server-only EventTrack services. See docs/beat-event-cache.md.
# Without these, deployed JSON cache files and local/decorative fallbacks work.
BEAT_EVENT_CACHE_ORIGIN=
BEAT_ANALYSIS_URL=
BEAT_ANALYSIS_KEY=
