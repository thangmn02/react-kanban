# Server-only. Supply a random key of at least 32 characters.
BEAT_ANALYSIS_KEY=
BEAT_ANALYSIS_DIRECTORY=/data
# Direct Python defaults to loopback; Docker defaults to 0.0.0.0 inside its container.
# BEAT_ANALYSIS_BIND=127.0.0.1
PORT=47700
BEAT_ANALYSIS_THREADS=2
TORCH_HOME=/models
# Optional full-media WAV files named <cacheKey>.wav. Never a public directory.
BEAT_MEDIA_DIRECTORY=
