# Server-only values. Copy to .env.local; never prefix these with VITE_.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_NOTIFICATION_TO=
# Use a sender on your verified Resend domain. onboarding@resend.dev is only
# suitable for testing delivery to the email registered with Resend.
CONTACT_NOTIFICATION_FROM=
CONTACT_ALLOWED_ORIGINS=https://your-app.example,http://localhost:5173
# Generate at least 32 random characters; keep stable across deployments.
CONTACT_IP_HASH_SECRET=
